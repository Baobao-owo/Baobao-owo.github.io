<%
	// 中二节奏谱面信息条
	const c = post.chuni;
	if (c) {
		const diffs = (c.diffs || []).filter(function (d) { return d && (d.cls || d.value); });
		const tagArr = post.tags ? post.tags.toArray().map(function (t) { return String(t.name); }) : [];
		const isCollab = tagArr.indexOf('合作谱') !== -1;
%>
<div class="map-info">
	<% if (c.cover) { %>
		<div class="chuni-info-cover" style="background-image:url('<%= c.cover %>')"></div>
	<% } %>
	<div class="map-info-body">
		<h3 class="map-info-title">
			<%= post.title %>
			<% if (isCollab) { %><span class="chuni-collab chuni-collab-inline">合作</span><% } %>
		</h3>
		<% if (c.artist) { %><div class="map-info-artist"><%= c.artist %></div><% } %>
		<% if (c.authors) { %><div class="map-info-mapper">谱师 <%= c.authors %></div><% } %>
		<% if (diffs.length) { %>
			<div class="map-diffs">
				<% diffs.forEach(function (d) { %>
					<span class="map-diff-btn chuni-diff-btn">
						<span class="map-diff-name"><%= d.cls === '速' ? '速' : (d.cls || '') %></span>
						<% if (d.value) { %><span class="map-diff-sr"><%= d.value %></span><% } %>
					</span>
				<% }); %>
			</div>
		<% } %>
		<% if (c.bundle || c.video) { %>
			<div class="map-info-links">
				<% if (c.bundle) { %>
					<div class="map-link-row">
						<span class="map-link-label">歌包链接</span>
						<a href="<%= c.bundle %>" target="_blank" rel="noopener"><%= c.bundle %></a>
					</div>
				<% } %>
				<% if (c.video) { %>
					<div class="map-link-row">
						<span class="map-link-label">B 站视频</span>
						<a href="<%= c.video %>" target="_blank" rel="noopener"><%= c.video %></a>
					</div>
				<% } %>
			</div>
		<% } %>
		<% if (c.video_desc) { %>
			<div class="chuni-block-label">B 站简介</div>
			<div class="chuni-desc"><%= c.video_desc %></div>
		<% } %>
		<% if (c.note) { %>
			<div class="chuni-block-label">补充说明</div>
			<div class="chuni-note"><%= c.note %></div>
		<% } %>
	</div>
</div>
<% } %>
