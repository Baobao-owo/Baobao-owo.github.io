<div id="post_feedback" class="card shadow-sm chuni-feedback-card">
	<div class="chuni-feedback-head">
		<span class="chuni-feedback-title">内容纠错</span>
		<span class="chuni-feedback-sub">发现错别字、数据错误、翻译不准或失效链接？</span>
	</div>
	<ul class="chuni-feedback-tips">
		<li><b>说位置</b>：小节标题、原文那一句，或第几行</li>
		<li><b>说问题</b>：哪里不对、为什么不对</li>
		<li><b>说改法</b>：建议改成什么（没有也行）</li>
	</ul>
	<div class="chuni-feedback-actions">
		<button type="button" id="feedback-copy-link" class="chuni-feedback-btn">复制本页链接</button>
		<span class="chuni-feedback-hint">提交需要 GitHub 账号登录</span>
	</div>
	<%- partial('_comment/giscus') %>
</div>
<script>
	(function () {
		var btn = document.getElementById('feedback-copy-link');
		if (!btn) return;
		btn.addEventListener('click', function () {
			var url = window.location.href;
			var done = function () {
				btn.textContent = '已复制';
				setTimeout(function () {
					btn.textContent = '复制本页链接';
				}, 2000);
			};
			if (navigator.clipboard && navigator.clipboard.writeText) {
				navigator.clipboard.writeText(url).then(done, done);
				return;
			}
			var input = document.createElement('input');
			document.body.appendChild(input);
			input.value = url;
			input.select();
			try {
				document.execCommand('copy');
			} catch (e) {}
			document.body.removeChild(input);
			done();
		});
	})();
</script>
