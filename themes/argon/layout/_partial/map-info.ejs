<%
	// 谱面信息条：只在带 map 字段的文章里显示
	const map = post.map;
	if (map) {
		const cover = map.cover
			? map.cover
			: (map.set_id ? 'https://assets.ppy.sh/beatmaps/' + map.set_id + '/covers/cover.jpg' : '');
		const mode = map.mode || 'mania';
		const diffs = (map.diffs || []).filter(function (d) { return d && d.name; });
		const defaultId = map.beatmap_id ? String(map.beatmap_id) : (diffs.length ? String(diffs[0].id) : '');
		function osuUrlOf(id) {
			return 'https://osu.ppy.sh/beatmapsets/' + map.set_id +
				(id ? ('#' + mode + '/' + id) : '');
		}
		const mainUrl = map.set_id ? osuUrlOf(defaultId) : '';
		const mirrorId = map.set_id ? String(map.set_id) : '';
%>
<div class="map-info">
	<% if (cover) { %>
		<div class="map-info-cover" style="background-image:url('<%= cover %>')"></div>
	<% } %>
	<div class="map-info-body">
		<h3 class="map-info-title"><%= post.title %></h3>
		<div class="map-info-artist">
			<%= map.artist || '' %>
			<% if (map.mapper) { %> · 谱师 <%= map.mapper %><% } %>
			<% if (map.status) { %> · <%= map.status %><% } %>
		</div>

		<% if (diffs.length) { %>
			<div class="map-diffs">
				<% diffs.forEach(function (d) { %>
					<a class="map-diff-btn<%= String(d.id) === defaultId ? ' active' : '' %>"
					   href="<%= osuUrlOf(d.id) %>" target="_blank" rel="noopener"
					   title="在 osu! 上查看这个难度">
						<span class="map-diff-name"><%= d.name %></span>
						<% if (d.sr) { %><span class="map-diff-sr">★ <%= d.sr %></span><% } %>
					</a>
				<% }); %>
			</div>
		<% } %>

		<div class="map-info-grid">
			<% if (map.keys) { %><div><span>键数</span><b><%= map.keys %>K</b></div><% } %>
			<% if (map.bpm) { %><div><span>BPM</span><b><%= map.bpm %></b></div><% } %>
			<% if (map.length) { %><div><span>时长</span><b><%= map.length %></b></div><% } %>
			<% if (diffs.length) { %><div><span>难度数</span><b><%= diffs.length %></b></div><% } %>
		</div>

		<div class="map-info-links">
			<% if (mainUrl) { %>
				<div class="map-link-row">
					<span class="map-link-label">谱面链接</span>
					<a href="<%= mainUrl %>" target="_blank" rel="noopener"><%= mainUrl %></a>
				</div>
			<% } %>
			<% if (mirrorId) { %>
				<div class="map-link-row">
					<span class="map-link-label">镜像站</span>
					<span>把 <code><%= mirrorId %></code> 输入 <a href="https://osu.sayobot.cn/home" target="_blank" rel="noopener">osu.sayobot.cn</a> 的搜索框就能下载</span>
				</div>
			<% } %>
		</div>
	</div>
</div>
<% } %>
