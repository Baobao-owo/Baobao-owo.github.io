<%
	const s = page.song || {};
	const sheets = s.sheets || [];
	const extra2 = page.extra || {};
	const winfo = extra2.wiki_info || {};
	const cats = (page.guide && page.guide.categories) || [];
	const catHit = cats.find(function (c) { return c.key === s.category; });
	const catLabel = catHit ? catHit.label : (s.category || '');
	const diffName = { basic: 'BASIC', advanced: 'ADVANCED', expert: 'EXPERT', master: 'MASTER', ultima: 'ULTIMA' };
	const diffLetter = { basic: 'B', advanced: 'A', expert: 'E', master: 'M', ultima: 'U' };

	const infoRows = [
		{ k: '分类', v: winfo['ジャンル'] || catLabel },
		{ k: '曲名', v: winfo['タイトル'] || s.title },
		{ k: '艺术家', v: winfo['アーティスト'] || s.artist },
		{ k: '原曲', v: winfo['原曲'] || '' },
		{ k: 'BPM', v: winfo['BPM'] || (s.bpm || '') },
		{ k: '解锁方式', v: winfo['解禁方法'] || (s.release || '') }
	].filter(function (r) { return r.v; });

	const jpText = extra2.wiki_comment || extra2.wiki_jp || '';
	const zhText = extra2.wiki_zh || '';
%>
<article class="post post-full card bg-white shadow-sm border-0">
	<div class="post-content" id="post_content">
		<div class="chuni-song">
			<a class="map-back" href="/chuni/">← 返回曲目导览</a>

			<div class="chuni-wiki-head">
				<div class="chuni-jacket-box">
					<% if (s.cover) { %>
						<img class="chuni-jacket" src="<%= s.cover %>" alt="" />
					<% } %>
					<div class="chuni-jacket-caption">
						<div class="chuni-jacket-caption-title">曲绘</div>
						<div class="chuni-jacket-caption-sub"><%= s.title %></div>
					</div>
				</div>
				<div class="chuni-info-box">
					<div class="chuni-info-box-title">曲目信息</div>
					<table class="chuni-info-table">
						<tbody>
						<% infoRows.forEach(function (r) { %>
							<tr>
								<th><%= r.k %></th>
								<td><%= r.v %></td>
							</tr>
						<% }); %>
						</tbody>
					</table>
					<% if (page.versionLabel) { %>
						<div class="chuni-info-version">收录版本：<%= page.versionLabel %></div>
					<% } %>
				</div>
			</div>

			<div class="chuni-section">
				<div class="chuni-section-title">介绍</div>
				<% if (jpText) { %>
					<div class="chuni-wiki-label">日文原文</div>
					<div class="chuni-wiki-jp"><%= jpText %></div>
				<% } %>
				<% if (zhText) { %>
					<div class="chuni-wiki-label">中文翻译</div>
					<div class="chuni-wiki-zh"><%= zhText %></div>
				<% } %>
				<% if (!jpText && !zhText) { %>
					<div class="chuni-placeholder">wiki 的曲目介绍还没搬，之后再补。</div>
				<% } %>
			</div>

			<div class="chuni-section">
				<div class="chuni-section-title">详细</div>
				<table class="chuni-detail-table">
					<thead>
						<tr>
							<th>难度</th>
							<th>等级</th>
							<th>物量</th>
							<th>谱面作者</th>
						</tr>
					</thead>
					<tbody>
					<% sheets.forEach(function (sh) { %>
						<%
							const n = sh.notes || {};
							const lvText = sh.internal && sh.internal !== sh.level ? sh.level + '（' + sh.internal + '）' : sh.level;
						%>
						<tr>
							<td><span class="chuni-badge chuni-badge-<%= sh.difficulty %>"><%= diffLetter[sh.difficulty] %></span> <span class="chuni-diff-name"><%= diffName[sh.difficulty] %></span></td>
							<td class="chuni-lv"><%= lvText %></td>
							<td><%= n.total || '—' %></td>
							<td class="chuni-designer"><%= sh.designer && sh.designer !== '-' ? sh.designer : '—' %></td>
						</tr>
					<% }); %>
					</tbody>
				</table>
				</div>

			<%
				const hist = extra2.history;
				const hasHist = hist && hist.rows && hist.rows.length > 1;
				const titlesRows = (extra2.titles || []).filter(function (r) { return r && r.length >= 2; });
				const hasTitles = titlesRows.length > 1;
				const origins = (extra2.origins || []).filter(Boolean);
			%>

			<% if (hasHist) { %>
			<div class="chuni-section">
				<div class="chuni-section-title">定数变更履历</div>
				<%
					function lvVal(t) {
						const m = String(t).trim().match(/^(\d+)(\+)?$/);
						if (!m) return null;
						return Number(m[1]) + (m[2] ? 0.5 : 0);
					}
					const histRows = hist.rows.slice(1);
				%>
				<table class="chuni-detail-table chuni-history-table">
					<thead>
						<tr>
							<% hist.rows[0].forEach(function (h) { %><th><%= h === 'バージョン' ? '版本' : h %></th><% }); %>
						</tr>
					</thead>
					<tbody>
						<% histRows.forEach(function (r, ri) { %>
							<tr>
								<% r.forEach(function (c, ci) { %>
									<%
										let cls = '';
										if (ci > 0 && ri > 0) {
											const cur = lvVal(c);
											const prev = lvVal(histRows[ri - 1][ci]);
											if (cur !== null && prev !== null) {
												if (cur > prev) cls = (cur - prev >= 1 ? 'lv-up lv-big' : 'lv-up');
												else if (cur < prev) cls = (prev - cur >= 1 ? 'lv-down lv-big' : 'lv-down');
											}
										}
									%>
									<td class="<%= cls %>"><%= c %></td>
								<% }); %>
							</tr>
						<% }); %>
					</tbody>
				</table>
				<% if (hist.notes && hist.notes.length) { %>
					<div class="chuni-history-notes">
						<% hist.notes.forEach(function (n) { %><div><%= n %></div><% }); %>
					</div>
				<% } %>
			</div>
			<% } %>

			<% if (hasTitles) { %>
			<div class="chuni-section">
				<div class="chuni-section-title">可获得称号</div>
				<table class="chuni-detail-table">
					<thead>
						<tr>
							<% titlesRows[0].forEach(function (h) { %><th><%= h %></th><% }); %>
						</tr>
					</thead>
					<tbody>
						<% titlesRows.slice(1).forEach(function (r) { %>
							<tr>
								<% r.forEach(function (c) { %><td><%= c %></td><% }); %>
							</tr>
						<% }); %>
					</tbody>
				</table>
			</div>
			<% } %>

			<% if (origins.length) { %>
			<div class="chuni-section">
				<div class="chuni-section-title">ND 名义与称号由来</div>
				<ul class="chuni-origins">
					<% origins.forEach(function (o) { %><li><%= o %></li><% }); %>
				</ul>
			</div>
			<% } %>

			<% if (extra2.wiki_extra_zh) { %>
			<div class="chuni-section">
				<div class="chuni-section-title">以上小节·中文翻译</div>
				<div class="chuni-wiki-zh"><%= extra2.wiki_extra_zh %></div>
			</div>
			<% } %>

			<div class="chuni-section">
				<div class="chuni-section-title">谱面预览</div>
				<% if (extra2.bili) { %>
					<div class="chuni-preview-row">
						<span class="chuni-preview-label">B 站</span>
						<a href="<%= extra2.bili %>" target="_blank" rel="noopener"><%= extra2.bili %></a>
					</div>
				<% } %>
				<% if (extra2.flat) { %>
					<div class="chuni-preview-row">
						<span class="chuni-preview-label">平面图</span>
						<a href="<%= extra2.flat %>" target="_blank" rel="noopener"><%= extra2.flat %></a>
					</div>
				<% } %>
				<% if (!extra2.bili && !extra2.flat) { %>
					<div class="chuni-placeholder">还没有预览，之后补 B 站视频或平面图。</div>
				<% } %>
			</div>

			<div class="chuni-section">
				<div class="chuni-section-title">手法交流</div>
				<div class="chuni-comments">
					<script src="https://giscus.app/client.js"
						data-repo="Baobao-owo/Baobao-owo.github.io"
						data-repo-id="R_kgDOVqnN2A"
						data-category="Announcements"
						data-category-id="DIC_kwDOVqnN2M4DK41l"
						data-mapping="pathname"
						data-strict="0"
						data-reactions-enabled="1"
						data-emit-metadata="0"
						data-input-position="top"
						data-theme="preferred_color_scheme"
						data-lang="zh-CN"
						crossorigin="anonymous"
						async>
					</script>
				</div>
			</div>
		</div>
	</div>
</article>
