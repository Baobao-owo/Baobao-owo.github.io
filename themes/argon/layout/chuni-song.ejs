<%
	const s = page.song || {};
	const sheets = s.sheets || [];
	const extra2 = page.extra || {};
	const winfo = extra2.wiki_info || {};
	const cats = (page.guide && page.guide.categories) || [];
	const catHit = cats.find(function (c) { return c.key === s.category; });
	const catLabel = catHit ? catHit.label : (s.category || '');
	const diffName = { basic: 'BASIC', advanced: 'ADVANCED', expert: 'EXPERT', master: 'MASTER', ultima: 'ULTIMA' };
	const diffLetter = { basic: 'B', advanced: 'A', expert: 'E', master: 'M', ultima: 'U' };

	const infoRows = [
		{ k: '分类', v: winfo['ジャンル'] || catLabel },
		{ k: '曲名', v: winfo['タイトル'] || s.title },
		{ k: '艺术家', v: winfo['アーティスト'] || s.artist },
		{ k: '原曲', v: winfo['原曲'] || '' },
		{ k: 'BPM', v: winfo['BPM'] || (s.bpm || '') },
		{ k: '解锁方式', v: winfo['解禁方法'] || (s.release || '') }
	].filter(function (r) { return r.v; });

	const jpText = extra2.wiki_comment || extra2.wiki_jp || '';
	const zhText = extra2.wiki_comment_zh || extra2.wiki_zh || '';
	const hist = extra2.history;
	const isWE = sheets.length > 0 && sheets.every(function (sh) { return /^【.*】$/.test(sh.difficulty); });
	const hasHist = !isWE && hist && hist.rows && hist.rows.length > 1;
	const titlesRows = (extra2.titles || []).filter(function (r) { return r && r.length >= 2; });
	const titlesZh = (extra2.titles_zh || []).filter(function (r) { return r && r.length >= 2; });
	const titleKinds = extra2.title_kinds || [];
	const hasTitles = titlesRows.length > 1;
	const origins = (extra2.origins || []).filter(Boolean);
	const originsZh = (extra2.origins_zh || []).filter(Boolean);
%>
<article class="post post-full card bg-white shadow-sm border-0">
	<div class="post-content" id="post_content">
		<div class="chuni-song">
			<a class="map-back" href="/chuni/">← 返回曲目导览</a>

			<div class="chuni-wiki-head">
				<div class="chuni-jacket-box">
					<% if (s.cover) { %>
						<img class="chuni-jacket" src="<%= s.cover %>" alt="" />
					<% } %>
					
				</div>
				<div class="chuni-info-box">
					<div class="chuni-info-box-title">曲目信息</div>
					<table class="chuni-info-table">
						<tbody>
						<% infoRows.forEach(function (r) { %>
							<tr>
								<th><%= r.k %></th>
								<td><%= r.v %></td>
							</tr>
						<% }); %>
						</tbody>
					</table>
					<div class="chuni-info-version">
						<% if (page.versionLabel) { %>收录版本：<%= page.versionLabel %><% } %>
						<% if (s.musicId) { %><span class="chuni-music-id">歌曲id：<%= s.musicId %></span><% } %>
					</div>
				</div>
			</div>

			<div class="chuni-section">
				<div class="chuni-section-title">介绍</div>
				<% if (jpText) { %>
					<div class="chuni-wiki-jp"><%= jpText %></div>
				<% } %>
				<% if (zhText) { %>
					<details class="chuni-zh">
						<summary>中文翻译</summary>
						<div class="chuni-wiki-zh"><%= zhText %></div>
					</details>
				<% } %>
				<% if (!jpText && !zhText) { %>
					<div class="chuni-placeholder">wiki 的曲目介绍还没搬，之后再补。</div>
				<% } %>
			</div>

			<div class="chuni-section">
				<div class="chuni-section-title">详细</div>
				<table class="chuni-detail-table">
					<thead>
						<tr>
							<th>难度</th>
							<th class="chuni-col-center">等级</th>
							<th class="chuni-col-center">定数</th>
							<th class="chuni-col-center">物量</th>
							<th>谱面作者</th>
						</tr>
					</thead>
					<tbody>
					<% sheets.forEach(function (sh) { %>
						<%
							const n = sh.notes || {};
							const lvText = sh.level;
							const ivText = sh.internal && sh.internal !== sh.level ? sh.internal : '—';
						%>
						<tr>
							<td><span class="chuni-badge chuni-badge-<%= sh.difficulty %> chuni-badge-letter"><%= diffLetter[sh.difficulty] %></span> <span class="chuni-diff-name"><%= diffName[sh.difficulty] %></span></td>
							<td class="chuni-lv chuni-col-center"><%= lvText %></td>
							<td class="chuni-iv chuni-col-center"><%= ivText %></td>
							<td class="chuni-col-center"><%= n.total || '—' %></td>
							<td class="chuni-designer"><%= sh.designer && sh.designer !== '-' ? sh.designer : '—' %></td>
						</tr>
					<% }); %>
					</tbody>
				</table>
			</div>

			<% if (hasHist) { %>
			<div class="chuni-section">
				<div class="chuni-section-title">定数变更履历</div>
				<%
					function lvVal(t) {
						const m = String(t).trim().match(/^(\d+(?:\.\d+)?)(\+)?$/);
						if (!m) return null;
						return Number(m[1]) + (m[2] ? 0.5 : 0);
					}
					const allRows = (extra2.history_expanded && extra2.history_expanded.length > 1) ? extra2.history_expanded : hist.rows;
					const histHead = allRows[0];
					const histRows = allRows.slice(1);
					const DIFF_FULL = { B: 'BASIC', A: 'ADVANCED', E: 'EXPERT', M: 'MASTER', U: 'ULTIMA' };
					function shortVer(v) { return String(v).replace(/CHUNITHM NEW/g, 'NEW').replace(/CHUNITHM /g, '').replace(/PARADISE LOST/g, 'PARADISE×').replace(/ PLUS/g, '+').trim(); }
				%>
				<table class="chuni-detail-table chuni-history-table">
					<thead>
						<tr>
							<% histHead.forEach(function (h) { %><th><%= h === 'バージョン' ? '版本' : (DIFF_FULL[h] || h) %></th><% }); %>
						</tr>
					</thead>
					<tbody>
						<% histRows.forEach(function (r, ri) { %>
							<tr>
								<% r.forEach(function (c, ci) { %>
									<%
										let cls = '';
										if (ci > 0 && ri > 0) {
											const cur = lvVal(c);
											const prev = lvVal(histRows[ri - 1][ci]);
											if (cur !== null && prev !== null) {
												if (cur > prev) cls = (cur - prev >= 1 ? 'lv-up lv-big' : 'lv-up');
												else if (cur < prev) cls = (prev - cur >= 1 ? 'lv-down lv-big' : 'lv-down');
											}
										}
									%>
									<td class="<%= cls %>"><%= ci === 0 ? shortVer(c) : c %></td>
								<% }); %>
							</tr>
						<% }); %>
					</tbody>
				</table>
			</div>
			<% } %>

			<% if (hasTitles) { %>
			<div class="chuni-section">
				<div class="chuni-section-title">可获得称号</div>
				<table class="chuni-detail-table chuni-titles-table">
					<thead>
						<tr>
							<% titlesRows[0].forEach(function (h) { %><th><%= h === '称号' ? '称号' : (h === '条件' ? '条件' : h) %></th><% }); %>
						</tr>
					</thead>
					<tbody>
						<% titlesRows.slice(1).forEach(function (r, ri) { %>
							<tr>
								<% r.forEach(function (c, ci) { %>
									<td<%- ci === 0 && titleKinds[ri] ? ' class="chuni-title chuni-title-' + titleKinds[ri] + '"' : '' %>><%= c %></td>
								<% }); %>
							</tr>
						<% }); %>
					</tbody>
				</table>
				<% if (titlesZh.length > 1) { %>
					<details class="chuni-zh">
						<summary>中文翻译</summary>
						<table class="chuni-detail-table chuni-titles-table">
							<thead>
								<tr><th>称号</th><th>条件</th></tr>
							</thead>
							<tbody>
								<% titlesZh.slice(1).forEach(function (r, ri) { %>
									<tr>
										<% r.forEach(function (c, ci) { %>
											<td<%- ci === 0 && titleKinds[ri] ? ' class="chuni-title chuni-title-' + titleKinds[ri] + '"' : '' %>><%= c %></td>
										<% }); %>
									</tr>
								<% }); %>
							</tbody>
						</table>
					</details>
				<% } %>
			</div>
			<% } %>

			<% if (origins.length) { %>
			<div class="chuni-section">
				<div class="chuni-section-title">ND 名义与称号由来</div>
				<ul class="chuni-origins">
					<% origins.forEach(function (o) { %><li><%= o %></li><% }); %>
				</ul>
				<% if (originsZh.length) { %>
					<details class="chuni-zh">
						<summary>中文翻译</summary>
						<ul class="chuni-origins">
							<% originsZh.forEach(function (o) { %><li><%= o %></li><% }); %>
						</ul>
					</details>
				<% } %>
			</div>
			<% } %>

			<div class="chuni-section">
				<div class="chuni-section-title">谱面预览</div>
				<%
					const previews = (s.previews || []).filter(Boolean);
					const previewSheets = sheets.map(function (sh, i) {
						return previews[i] ? { sh: sh, url: previews[i], index: i } : null;
					}).filter(Boolean);
				%>
				<% if (previewSheets.length) { %>
					<div class="chuni-chart-tabs">
						<% previewSheets.forEach(function (p, k) { %>
							<button type="button" class="chuni-chart-tab<%= k === 0 ? ' active' : '' %>" data-url="<%= p.url %>">
								<span class="chuni-badge chuni-badge-<%= p.sh.difficulty %>"><%= diffLetter[p.sh.difficulty] %></span>
								<span class="chuni-chart-tab-name"><%= diffName[p.sh.difficulty] %></span>
								<span class="chuni-chart-tab-lv"><%= p.sh.level %></span>
							</button>
						<% }); %>
					</div>
					<a class="chuni-chart-link" id="chuni-chart-link" href="<%= previewSheets[0].url %>" rel="noopener">
						<img id="chuni-chart-img" src="<%= previewSheets[0].url %>" alt="谱面平面图" loading="lazy" />
						<span class="chuni-chart-open">点击放大 ⤢</span>
					</a>
					<div class="chuni-chart-hint">点图片在页面内放大查看（可拖动/滚动），难度用上面的按钮切换。</div>

					<div class="chuni-lightbox" id="chuni-lightbox" hidden>
						<div class="chuni-lightbox-bar">
							<a class="chuni-lightbox-btn" id="chuni-lightbox-save" href="#" target="_blank" rel="noopener" download>保存原图</a>
							<button type="button" class="chuni-lightbox-btn" id="chuni-lightbox-close" aria-label="关闭">关闭 ✕</button>
						</div>
						<div class="chuni-lightbox-body" id="chuni-lightbox-body">
							<div class="chuni-lightbox-stage" id="chuni-lightbox-stage">
								<img id="chuni-lightbox-img" alt="谱面平面图" />
							</div>
						</div>
					</div>

					<script>
					(function () {
						var link = document.getElementById('chuni-chart-link');
						var box = document.getElementById('chuni-lightbox');
						var body = document.getElementById('chuni-lightbox-body');
						var stage = document.getElementById('chuni-lightbox-stage');
						var img = document.getElementById('chuni-lightbox-img');
						var save = document.getElementById('chuni-lightbox-save');
						var closeBtn = document.getElementById('chuni-lightbox-close');
						if (!link || !box || !stage) return;

						var scale = 1;
						var tx = 0;
						var ty = 0;
						var dragging = false;
						var dragMoved = false;
						var startX = 0;
						var startY = 0;
						var startTx = 0;
						var startTy = 0;

						function apply() {
							stage.style.transform = 'translate(' + tx + 'px,' + ty + 'px) scale(' + scale + ')';
						}

						function center() {
							var bw = body.clientWidth;
							var bh = body.clientHeight;
							var iw = img.offsetWidth || img.naturalWidth || 0;
							var ih = img.offsetHeight || img.naturalHeight || 0;
							tx = iw < bw ? Math.round((bw - iw) / 2) : 0;
							ty = ih < bh ? Math.round((bh - ih) / 2) : 0;
							apply();
						}

						function reset() {
							scale = 1;
							center();
						}

						function open() {
							var src = (document.getElementById('chuni-chart-img') || {}).src || link.getAttribute('href');
							img.src = src;
							save.href = src;
							box.hidden = false;
							document.documentElement.style.overflow = 'hidden';
							scale = 1;
							tx = 0;
							ty = 0;
							apply();
						}

						img.addEventListener('load', reset);

						function close() {
							box.hidden = true;
							img.src = '';
							document.documentElement.style.overflow = '';
						}

						link.addEventListener('click', function (e) {
							e.preventDefault();
							open();
						});
						closeBtn.addEventListener('click', close);
						box.addEventListener('click', function (e) {
							if (dragMoved) { dragMoved = false; return; }
							if (e.target === box || e.target === body) close();
						});
						document.addEventListener('keydown', function (e) {
							if (e.key === 'Escape' && !box.hidden) close();
						});

						// 滚轮缩放：以鼠标位置为锚点
						body.addEventListener('wheel', function (e) {
							if (box.hidden) return;
							e.preventDefault();
							var rect = body.getBoundingClientRect();
							var mx = e.clientX - rect.left;
							var my = e.clientY - rect.top;
							var factor = e.deltaY < 0 ? 1.12 : 1 / 1.12;
							var next = Math.min(8, Math.max(0.15, scale * factor));
							var k = next / scale;
							tx = mx - (mx - tx) * k;
							ty = my - (my - ty) * k;
							scale = next;
							apply();
						}, { passive: false });

						// 拖拽平移
						body.addEventListener('pointerdown', function (e) {
							if (box.hidden) return;
							dragging = true;
							dragMoved = false;
							startX = e.clientX;
							startY = e.clientY;
							startTx = tx;
							startTy = ty;
							body.classList.add('dragging');
							if (body.setPointerCapture) {
								try { body.setPointerCapture(e.pointerId); } catch (err) {}
							}
						});
						body.addEventListener('pointermove', function (e) {
							if (!dragging) return;
							var dx = e.clientX - startX;
							var dy = e.clientY - startY;
							if (Math.abs(dx) + Math.abs(dy) > 4) dragMoved = true;
							tx = startTx + dx;
							ty = startTy + dy;
							apply();
						});
						function endDrag() {
							dragging = false;
							body.classList.remove('dragging');
						}
						body.addEventListener('pointerup', endDrag);
						body.addEventListener('pointercancel', endDrag);
						body.addEventListener('dragstart', function (e) { e.preventDefault(); });
						body.addEventListener('dblclick', reset);
					})();
					</script>
				<% } %>
				<% if (extra2.bili) { %>
					<div class="chuni-preview-row">
						<span class="chuni-preview-label">B 站</span>
						<a href="<%= extra2.bili %>" target="_blank" rel="noopener"><%= extra2.bili %></a>
					</div>
				<% } %>
				<% if (!previewSheets.length && !extra2.bili && !extra2.flat) { %>
					<div class="chuni-placeholder">还没有预览，之后补平面图或 B 站视频。</div>
				<% } %>
			</div>

			<script>
			(function () {
				document.querySelectorAll('.chuni-chart-tab').forEach(function (btn) {
					btn.addEventListener('click', function () {
						document.querySelectorAll('.chuni-chart-tab').forEach(function (b) { b.classList.toggle('active', b === btn); });
						var img = document.getElementById('chuni-chart-img');
						var link = document.getElementById('chuni-chart-link');
						if (img) img.src = btn.getAttribute('data-url');
						if (link) link.href = btn.getAttribute('data-url');
					});
				});
			})();
			</script>

			<div class="chuni-section">
				<div class="chuni-section-title">谱面确认</div>
				<%
					const confirms = s.confirms || {};
					const ytMap = s.youtube || {};
					const confirmRows = sheets
						.filter(function (sh) { return sh.difficulty === 'master' || sh.difficulty === 'ultima'; })
						.map(function (sh) {
							const letter = diffLetter[sh.difficulty];
							const yts = (ytMap[letter] || []).filter(Boolean);
							// 两条时用后一条（9速）
							const yt = yts.length ? yts[yts.length - 1] : '';
							return { sh: sh, letter: letter, bili: confirms[letter] || '', yt: yt };
						})
						.filter(function (r) { return r.bili || r.yt; });
				%>
				<% if (confirmRows.length) { %>
					<div class="chuni-confirm-list">
						<% confirmRows.forEach(function (r) { %>
							<div class="chuni-confirm-row">
								<a class="chuni-confirm-name" href="<%= r.bili || ('https://www.youtube.com/watch?v=' + r.yt) %>" target="_blank" rel="noopener">
									<span class="chuni-badge chuni-badge-<%= r.sh.difficulty %>"><%= r.letter %></span>
									<span><%= diffName[r.sh.difficulty] %></span>
									<span class="chuni-confirm-src"><%= r.sh.level %></span>
								</a>
								<% if (r.bili) { %>
									<a class="chuni-video-link bili" href="<%= r.bili %>" target="_blank" rel="noopener">B 站</a>
								<% } %>
								<% if (r.yt) { %>
									<a class="chuni-video-link yt" href="https://www.youtube.com/watch?v=<%= r.yt %>" target="_blank" rel="noopener">YouTube</a>
								<% } %>
							</div>
						<% }); %>
					</div>
				<% } %>
			</div>

			<div class="chuni-section chuni-comment-section" id="chuni-comment">
				<div class="chuni-section-title">评论</div>
				<% if (theme.giscus && theme.giscus.song_enable && theme.giscus.repo && theme.giscus.repo_id && theme.giscus.category_id) { %>
					<div class="chuni-comment-box">
						<%- partial('_comment/giscus') %>
					</div>
				<% } else { %>
					<div class="chuni-comment-tip">评论区还没接好，稍后再来（等我把 giscus 的仓库信息填上）。</div>
				<% } %>
			</div>
		</div>
	</div>
</article>
