<%
	// 首页只放大板块入口：点进去才是子分类 / 列表，再点才是文章
	const boards = configured_categories();
	const countOf = {};
	site.categories.each(function (c) { countOf[c.name] = c.length; });
	const pathOf = {};
	site.categories.each(function (c) { pathOf[c.name] = c.path; });
	const boardsWithPosts = boards.filter(function (b) { return pathOf[b.name]; });
	// 子分类不算顶层板块，别在首页重复露出来
	const childNames = [];
	boards.forEach(function (b) {
		category_children(b.name).forEach(function (k) { childNames.push(k.name); });
	});
	// 没在配置里出现的分类也露出来，免得文章“消失”
	const extra = site.categories.toArray().filter(function (c) {
		if (childNames.indexOf(c.name) !== -1) return false;
		return !boards.some(function (b) { return b.name === c.name; });
	});
%>
<div class="board-grid">
<% boards.forEach(function (board) { %>
	<%
		const kids = category_children(board.name);
		const path = pathOf[board.name];
		const count = countOf[board.name] || 0;
	%>
	<% if (path) { %>
		<a class="board-card" href="<%= url_for(path) %>">
	<% } else { %>
		<div class="board-card board-card-empty">
	<% } %>
		<div class="board-card-top">
			<h2 class="board-card-title"><span class="home-section-dot"></span><%= board.name %></h2>
			<span class="board-card-count"><%= count %> 篇</span>
		</div>
		<% if (board.description) { %>
			<p class="board-card-desc"><%= board.description %></p>
		<% } %>
		<% if (kids.length) { %>
			<div class="board-card-kids">
				<% kids.forEach(function (k) { %><span><%= k.name %></span><% }); %>
			</div>
		<% } %>
		<span class="board-card-more"><%= path ? '进入板块 →' : '还没有内容' %></span>
	<% if (path) { %></a><% } else { %></div><% } %>
<% }); %>
<% extra.forEach(function (cat) { %>
	<a class="board-card" href="<%= url_for(cat.path) %>">
		<div class="board-card-top">
			<h2 class="board-card-title"><span class="home-section-dot"></span><%= cat.name %></h2>
			<span class="board-card-count"><%= cat.length %> 篇</span>
		</div>
		<span class="board-card-more">进入板块 →</span>
	</a>
<% }); %>
</div>
<div class="home-all">
	<a class="home-all-link" href="<%= url_for('/archives/') %>">全部文章 · 归档 →</a>
</div>
