<div class="wl-wrap">
	<div class="wl-anon-bar">
		<label class="wl-anon-label">
			<input type="checkbox" id="wl-anon-toggle" />
			<span>匿名评论</span>
			<small>公屏会显示为「匿名用户」，站长后台仍能看到你的邮箱与 IP</small>
		</label>
	</div>
	<div id="waline"></div>
</div>

<script>
	(function () {
		var ANON_NAME = '匿名用户';
		var anonOn = false;
		var savedNick = '';

		function findNickInput() {
			var inputs = document.querySelectorAll('#waline input');
			for (var i = 0; i < inputs.length; i++) {
				var p = (inputs[i].getAttribute('placeholder') || '') + ' ' + (inputs[i].name || '') + ' ' + (inputs[i].id || '');
				if (p.indexOf('昵称') !== -1 || /nick/i.test(p)) return inputs[i];
			}
			return null;
		}

		function setValue(input, value) {
			var setter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;
			setter.call(input, value);
			input.dispatchEvent(new Event('input', { bubbles: true }));
			input.dispatchEvent(new Event('change', { bubbles: true }));
		}

		function applyAnon() {
			var input = findNickInput();
			if (!input) return;
			if (anonOn) {
				if (input.value && input.value !== ANON_NAME) savedNick = input.value;
				if (input.value !== ANON_NAME) setValue(input, ANON_NAME);
				input.setAttribute('readonly', 'readonly');
				input.classList.add('wl-anon-input');
			} else {
				input.removeAttribute('readonly');
				input.classList.remove('wl-anon-input');
				if (input.value === ANON_NAME) setValue(input, savedNick);
			}
		}

		var box = document.getElementById('wl-anon-toggle');
		if (box) {
			box.addEventListener('change', function () {
				anonOn = box.checked;
				applyAnon();
			});
		}
		setInterval(applyAnon, 400);

		function startWaline() {
			var api = window.Waline;
			var init = api && typeof api.init === 'function' ? api.init : null;
			if (!init) {
				setTimeout(startWaline, 200);
				return;
			}
			init({
				el: '#waline',
				serverURL: '<%= theme.waline.server_url %>',
				lang: 'zh-CN',
				login: 'disable',
				meta: ['nick', 'mail'],
				requiredMeta: ['nick', 'mail'],
				pageview: false,
				comment: true,
				reaction: false,
				search: false,
				dark: 'html.darkmode',
			});
		}

		startWaline();
	})();
</script>
