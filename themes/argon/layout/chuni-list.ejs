<%
	const g = page.guide || {};
	const cats = g.categories || [];
	const versions = g.versions || [];
	const cfg = (site.data && site.data.chuni_config) || {};
%>
<article class="post post-full card bg-white shadow-sm border-0">
	<div class="post-content" id="post_content">
		<div class="chuni-guide">
			<div class="chuni-guide-head">
				<a class="map-back" href="/categories/中二节奏/">← 返回 中二节奏</a>
				<h2 class="chuni-guide-title">曲目导览</h2>
				<div class="chuni-guide-meta">
					<span id="chuni-total">—</span> 首 · 数据更新 <%= g.updated || '' %> · 来源 <%= g.source || '' %>
				</div>
			</div>

			<div class="chuni-toolbar">
				<div class="chuni-toolbar-main">
					<div class="chuni-seg" id="chuni-version">
						<button type="button" class="chuni-seg-btn active" data-version="all">日服 MATE</button>
						<button type="button" class="chuni-seg-btn" data-version="cn">国服 2027</button>
					</div>
					<select id="chuni-cat" class="chuni-select">
						<option value="all">全部分类</option>
						<% cats.forEach(function (c) { %>
							<option value="<%= c.key %>"><%= c.label %></option>
						<% }); %>
					</select>
					<div class="chuni-sort" id="chuni-sort">
						<button type="button" class="chuni-sort-btn active" data-sort="title">按标题首字母</button>
						<button type="button" class="chuni-sort-btn" data-sort="version">按版本稼动</button>
						<button type="button" class="chuni-sort-btn" data-sort="const">按定数</button>
						<button type="button" class="chuni-sort-btn" id="chuni-dir" data-sort="dir">正序 ↑</button>
						<button type="button" class="chuni-sort-btn chuni-designer-toggle" id="chuni-designer-toggle" aria-expanded="false">按谱师筛选</button>
					</div>
					<span class="chuni-count" id="chuni-count"></span>
				</div>
				<div class="chuni-toolbar-filters">
					<button type="button" class="chuni-removed-btn" id="chuni-removed">删除曲</button>
					<button type="button" class="chuni-removed-btn" id="chuni-we">WORLD'S END</button>
				</div>
			</div>

			<div class="chuni-designer-panel" id="chuni-designer-panel" hidden>
				<div class="chuni-designer-head">
					<span class="chuni-designer-heading">按谱师筛选<em id="chuni-designer-hint"></em></span>
					<span class="chuni-designer-actions">
						<button type="button" class="chuni-designer-clear" id="chuni-designer-clear">清除</button>
						<button type="button" class="chuni-designer-close" id="chuni-designer-close">收起</button>
					</span>
				</div>
				<div class="chuni-designer-diff" id="chuni-designer-diff">
					<button type="button" class="chuni-diff-chip active" data-diff="all">全部难度</button>
					<button type="button" class="chuni-diff-chip diff-b" data-diff="b">BASIC</button>
					<button type="button" class="chuni-diff-chip diff-a" data-diff="a">ADVANCED</button>
					<button type="button" class="chuni-diff-chip diff-e" data-diff="e">EXPERT</button>
					<button type="button" class="chuni-diff-chip diff-m" data-diff="m">MASTER</button>
					<button type="button" class="chuni-diff-chip diff-u" data-diff="u">ULTIMA</button>
					<button type="button" class="chuni-diff-chip chuni-collab-chip" id="chuni-collab-toggle" title="只显示合作谱：对不上的难度定数会变灰">仅显示合作</button>
				</div>
				<input type="search" class="chuni-search chuni-designer-q" id="chuni-designer-q" placeholder="搜索谱师名（49 位）…" />
				<div class="chuni-designer-grid" id="chuni-designer-grid"></div>
				<details class="chuni-designer-loose" id="chuni-designer-loose-wrap">
					<summary id="chuni-designer-loose-summary">其他名义</summary>
					<div class="chuni-designer-grid" id="chuni-designer-loose"></div>
				</details>
			</div>

			<div class="chuni-levels" id="chuni-levels"></div>

			<div class="chuni-searches">
				<input type="search" id="chuni-search-title" class="chuni-search" placeholder="搜曲名…" />
				<input type="search" id="chuni-search-artist" class="chuni-search" placeholder="搜艺术家…" />
			</div>

			<div class="chuni-list" id="chuni-list"></div>
			<div class="chuni-empty" id="chuni-empty" hidden>没有符合条件的曲目</div>
			<div class="chuni-pager" id="chuni-pager"></div>
			<div class="chuni-loading" id="chuni-loading">正在加载曲目…</div>
		</div>
	</div>
</article>

<script>
(function () {
	var VERSION_KEYS = <%- JSON.stringify(versions.map(function (v) { return v.key; })) %>;
	var CN_VERSIONS = <%- JSON.stringify(cfg.cn_versions || []) %>;
	var PAGE_SIZE = 50;
	var state = { version: 'all', qt: '', qa: '', cat: 'all', designer: '', designerRaw: '', designerDiff: [], collab: false, levels: [], sort: 'title', dir: 1, removed: false, we: false, page: 1 };
	// 返回列表时恢复上次的筛选/排序/滚动位置
	var LIST_STATE_KEY = 'chuni-list-state-v1';
	function saveListState() {
		try {
			sessionStorage.setItem(LIST_STATE_KEY, JSON.stringify({ state: state, scroll: window.scrollY, ts: Date.now() }));
		} catch (e) {}
	}
	function loadListState() {
		try {
			// 列表页点进曲目页时会写这个 key；回来就恢复（2 小时内有效）
			var raw = sessionStorage.getItem(LIST_STATE_KEY);
			if (!raw) return null;
			var obj = JSON.parse(raw);
			if (obj.ts && Date.now() - obj.ts > 2 * 3600 * 1000) {
				sessionStorage.removeItem(LIST_STATE_KEY);
				return null;
			}
			return obj;
		} catch (e) {
			return null;
		}
	}
	var DESIGNERS = null;
	var COLLAB = null;
	var savedListState = null;
	var listStateApplied = false;
	function applySavedListState() {
		if (!savedListState || listStateApplied) return;
		try {
			Object.keys(savedListState.state || {}).forEach(function (k) { state[k] = savedListState.state[k]; });
			syncControls();
			syncDesignerUI();
		} catch (e) {}
		listStateApplied = true;
	}

	var all = [];
	var listEl = document.getElementById('chuni-list');
	var pagerEl = document.getElementById('chuni-pager');
	var countEl = document.getElementById('chuni-count');
	var totalEl = document.getElementById('chuni-total');
	var emptyEl = document.getElementById('chuni-empty');
	var loadingEl = document.getElementById('chuni-loading');
	var levelsEl = document.getElementById('chuni-levels');

	// 把 state 回显到工具栏控件上
	function syncControls() {
		document.querySelectorAll('#chuni-version button[data-version]').forEach(function (b) {
			b.classList.toggle('active', b.getAttribute('data-version') === state.version);
		});
		var catEl = document.getElementById('chuni-cat');
		if (catEl) catEl.value = state.cat;
		document.querySelectorAll('#chuni-sort button[data-sort]').forEach(function (b) {
			var s = b.getAttribute('data-sort');
			if (s === 'dir') return;
			b.classList.toggle('active', s === state.sort);
		});
		var dirEl = document.getElementById('chuni-dir');
		if (dirEl) dirEl.textContent = state.dir === 1 ? '正序 ↑' : '倒序 ↓';
		var stEl = document.getElementById('chuni-search-title');
		if (stEl) stEl.value = state.qt || '';
		var saEl = document.getElementById('chuni-search-artist');
		if (saEl) saEl.value = state.qa || '';
		var rmEl = document.getElementById('chuni-removed');
		if (rmEl) rmEl.classList.toggle('active', !!state.removed);
		var weEl = document.getElementById('chuni-we');
		if (weEl) weEl.classList.toggle('active', !!state.we);
		document.querySelectorAll('#chuni-levels button[data-level]').forEach(function (b) {
			b.classList.toggle('active', (state.levels || []).indexOf(b.getAttribute('data-level')) >= 0);
		});
	}

	// 点歌进详情页前，把当前状态存起来
	document.addEventListener('click', function (e) {
		var a = e.target && e.target.closest ? e.target.closest('a[href^="/chuni/"]') : null;
		if (a) saveListState();
	});
	window.addEventListener('pagehide', saveListState);

	// 难度等级：从数据里收集，形如 14 / 14+
	function levelKey(lv) {
		var s = String(lv || '').trim();
		var m = s.match(/^(\d+(?:\.\d+)?)(\+?)$/);
		return m ? m[1] + (m[2] ? '+' : '') : s;
	}
	function levelNum(key) {
		var m = String(key).match(/^(\d+(?:\.\d+)?)/);
		return m ? Number(m[1]) : 99;
	}

	function collectLevels() {
		var set = {};
		all.forEach(function (r) {
			(r.sh || []).forEach(function (sh) {
				var k = levelKey(sh.lv);
				if (/^\d+(\.\d+)?\+?$/.test(k)) set[k] = true;
			});
		});
		return Object.keys(set).sort(function (a, b) {
			var d = levelNum(a) - levelNum(b);
			if (d) return d;
			return a.indexOf('+') - b.indexOf('+');
		});
	}

	function tierOf(key) {
		var n = levelNum(key);
		if (n <= 4) return 'g';
		if (n <= 7) return 'b';
		if (n <= 10) return 'r';
		if (n <= 14) return 'p';
		return 'd';
	}

	function renderLevelChips() {
		if (!levelsEl) return;
		var levels = collectLevels();
		levelsEl.innerHTML = levels.map(function (lv) {
			return '<button type="button" class="chuni-lv-chip tier-' + tierOf(lv) + '" data-level="' + lv + '">' + lv + '</button>';
		}).join('');
	}

	function songLevelKeys(r) {
		return (r.sh || []).map(function (sh) { return levelKey(sh.lv); });
	}

	// 合作谱覆盖到的难度（e/m/u）；选了谱师时只看他参与合作的
	function collabKeysOf(r) {
		var c = collabEntry(r);
		if (!c) return [];
		var out = [];
		var keys = (state.designerDiff && state.designerDiff.length) ? state.designerDiff.slice() : ['e', 'm', 'u'];
		keys.forEach(function (k) {
			var ppl = c[k];
			if (!ppl || ppl.length < 2) return;
			if ((state.designer || state.designerRaw) && ppl.indexOf(state.designer) === -1) return;
			out.push(k);
		});
		return out;
	}

	// 当前该亮哪几个难度（e/m/u）；null = 全亮
	function visibleKeys(r) {
		if (state.collab) return collabKeysOf(r);
		if (state.designer || state.designerRaw) return matcher(r).map(function (x) { return x.d; });
		return null;
	}

	function designerDiffKeys(r) {
		var map = { b: 'basic', a: 'advanced', e: 'expert', m: 'master', u: 'ultima' };
		var k = visibleKeys(r);
		return k ? k.map(function (x) { return map[x]; }) : null;
	}

	function levelMatch(r) {
		if (!state.levels.length) return true;
		var only = designerDiffKeys(r);
		var keys = (r.sh || []).filter(function (sh) {
			if (!only) return true;
			return only.indexOf(sh.d) !== -1;
		}).map(function (sh) { return levelKey(sh.lv); });
		return state.levels.some(function (lv) { return keys.indexOf(lv) !== -1; });
	}

	function normTitle(s) {
		return String(s || '').normalize('NFKC').replace(/\s+/g, ' ').trim().toLowerCase();
	}

	function designerEntry(r) {
		if (!DESIGNERS || !DESIGNERS.songs) return null;
		return DESIGNERS.songs[normTitle(r.t)] || null;
	}

	function collabEntry(r) {
		if (!COLLAB || !COLLAB.songs) return null;
		return COLLAB.songs[normTitle(r.t)] || null;
	}

	function matcher(r) {
		// 当前选中的谱师在这首歌里对得上哪些难度（单人 / 合作）
		var e = designerEntry(r);
		var c = collabEntry(r);
		var out = [];
		['e', 'm', 'u'].forEach(function (k) {
			var hit = e && e[k];
			var isCollab = !!(state.collab && state.designer && c && c[k] && c[k].indexOf(state.designer) !== -1);
			// 合作优先：一张谱既是「署名归了他」又在合作名单里，就当合作处理，
			// 否则「仅显示合作」会把它筛掉
			if (isCollab) {
				out.push({ d: k, kind: 'collab', people: c[k] });
				return;
			}
			if (hit) {
				if (state.designer && hit.who === state.designer) out.push({ d: k, kind: 'solo', who: hit.who });
				else if (state.designerRaw && hit.raw === state.designerRaw) out.push({ d: k, kind: 'solo', who: hit.raw });
			}
		});
		if (state.designerDiff && state.designerDiff.length) out = out.filter(function (x) { return state.designerDiff.indexOf(x.d) !== -1; });
		return out;
	}

	function designerMatch(r) {
		return matcher(r).length > 0;
	}

	function filtered() {
		var qt = state.qt.trim().toLowerCase();
		var qa = state.qa.trim().toLowerCase();
		var rows = all.filter(function (r) {
			if (state.version === 'cn' && !r.cn && !(state.removed && r.cnrm)) return false;
			var isDel = !!(r.rm || r.cnrm);
			var isWE = !!(r.we && r.we.length);
			if (state.removed) {
				if (!isDel) return false;
				// 「删除曲」里只放普通谱面；被删除的 WE 谱面归 WORLD'S END 开关管
				if (isWE && !state.we) return false;
			}
			if (state.we && !isWE) return false;
			if (!state.removed && !state.we && (isDel || isWE)) return false;
			if (state.cat !== 'all' && r.c !== state.cat) return false;
			if ((state.designer || state.designerRaw) && !designerMatch(r)) return false;
			if (state.collab && COLLAB) {
				// 仅显示合作：这首歌要有合作谱（同一难度两人以上联名）
				if (!collabEntry(r)) return false;
				if ((state.designer || state.designerRaw) && !matcher(r).some(function (x) { return x.kind === 'collab'; })) return false;
			}
			if (!levelMatch(r)) return false;
			if (qt && String(r.t).toLowerCase().indexOf(qt) === -1) return false;
			if (qa && String(r.a).toLowerCase().indexOf(qa) === -1) return false;
			return true;
		});
		var vIndex = {};
		VERSION_KEYS.forEach(function (k, i) { vIndex[k] = i; });
		function starOf(r) {
			if (!r.we || !r.we.length) return 0;
			return Math.max.apply(null, r.we);
		}

		// 参与排序的谱面 = 页面上真正显示定数的那几张
		// （选了谱师 → 只算他写的谱；仅显示合作 → 只算合作那张；选了定数档 → 只算这些档）
		function shownSheets(r) {
			var onlyDiff = designerDiffKeys(r);
			return (r.sh || []).filter(function (sh) {
				if (DIFF_ORDER.indexOf(sh.d) === -1) return false;
				if (onlyDiff && onlyDiff.indexOf(sh.d) === -1) return false;
				if (state.levels.length && state.levels.indexOf(levelKey(sh.lv)) === -1) return false;
				return true;
			});
		}

		function maxConst(r) {
			var best = -1;
			var sheets = shownSheets(r);
			if (!sheets.length) sheets = (r.sh || []).filter(function (sh) { return DIFF_ORDER.indexOf(sh.d) !== -1; });
			sheets.forEach(function (sh) {
				var v = (state.version === 'cn' && sh.cn != null) ? sh.cn : sh.iv;
				if (v != null && !isNaN(v) && v > best) best = v;
			});
			return best;
		}
		rows.sort(function (x, y) {
			var d = 0;
			if (state.sort === 'version') {
				d = (vIndex[x.v] == null ? 99 : vIndex[x.v]) - (vIndex[y.v] == null ? 99 : vIndex[y.v]);
				if (d) return d * state.dir;
			}
			if (state.sort === 'const') {
				var starX = starOf(x);
				var starY = starOf(y);
				// 两边都是 WE：按星星数
				if (starX && starY) {
					d = starX - starY;
					if (d) return d * state.dir;
					return 0;
				}
				// 一边 WE 一边普通：普通在前
				if (starX && !starY) return 1;
				if (starY && !starX) return -1;
				var mx = maxConst(x);
				var my = maxConst(y);
				if (mx < 0 && my >= 0) return 1;
				if (my < 0 && mx >= 0) return -1;
				d = mx - my;
				if (d) return d * state.dir;
			}
			if (state.sort === 'title') {
				return String(x.t).localeCompare(String(y.t), 'ja') * state.dir;
			}
			return 0;
		});
		return rows;
	}

	var DIFF_ORDER = ['basic', 'advanced', 'expert', 'master', 'ultima'];
	var DIFF_LETTER = { basic: 'B', advanced: 'A', expert: 'E', master: 'M', ultima: 'U' };

	function fmtConst(n) {
		if (n == null || isNaN(n)) return '';
		var v = Math.round(Number(n) * 10) / 10;
		return (Math.abs(v % 1) < 0.05) ? String(Math.round(v)) : v.toFixed(1);
	}

	function badge(value, diff) {
		return '<span class="chuni-badge chuni-badge-' + diff + '">' + fmtConst(value) + '</span>';
	}

	function renderRows() {
		var rows = filtered();
		var pages = Math.max(1, Math.ceil(rows.length / PAGE_SIZE));
		if (state.page > pages) state.page = pages;
		var start = (state.page - 1) * PAGE_SIZE;
		var pageRows = rows.slice(start, start + PAGE_SIZE);

		var html = pageRows.map(function (r) {
			if (r.we && r.we.length && state.we) {
				var stars = r.we.map(function (n) { return '<span class="chuni-badge chuni-badge-we">☆' + n + (r.weAttr ? ' ' + r.weAttr : '') + '</span>'; }).join('');
				return '<a class="chuni-row" href="' + r.u + '">' +
					'<img class="chuni-thumb" src="' + r.cov + '" alt="" loading="lazy" />' +
					'<div class="chuni-row-main"><div class="chuni-row-title">' + r.t + '</div>' +
					'<div class="chuni-row-sub">' + r.a + ' · BPM ' + (r.b || '?') + ' · ' + r.v + '</div></div>' +
					'<div class="chuni-row-badges">' + stars + '</div>' +
					'</a>';
			}
			var dInfo = (state.designer || state.designerRaw) ? matcher(r) : null;
			if (dInfo && state.collab) dInfo = dInfo.filter(function (x) { return x.kind === 'collab'; });
			// 定数遮罩：仅显示合作时，非合作难度一律变灰
			var dKeySet = visibleKeys(r);
			var dsTag = '';
			if (dInfo && dInfo.length) {
				var parts = dInfo.map(function (x) {
					var k = x.d.toUpperCase();
					if (x.kind === 'collab') return k + ' 合作 ' + x.people.join(' × ');
					return k + ' ' + x.who;
				});
				var isCollab = dInfo.some(function (x) { return x.kind === 'collab'; });
				dsTag = '<span class="chuni-row-tag-ds' + (isCollab ? ' is-collab' : '') + '">' + parts.join(' / ') + '</span>';
			}
			if (!dsTag && state.collab) {
				var ceRow = collabEntry(r);
				var cParts = [];
				if (ceRow) {
					['e', 'm', 'u'].forEach(function (k) {
						var ppl = ceRow[k];
						if (ppl && ppl.length > 1) cParts.push(k.toUpperCase() + ' 合作 ' + ppl.join(' × '));
					});
				}
				if (cParts.length) dsTag = '<span class="chuni-row-tag-ds is-collab">' + cParts.join(' / ') + '</span>';
			}
			var byDiff = {};
			(r.sh || []).forEach(function (sh) { byDiff[sh.d] = sh; });
			// 选了谱师时，只给「他写的那张谱」显示定数，其它难度留空
			var DESIGNER_KEY = { expert: 'e', master: 'm', ultima: 'u' };
			var badges = DIFF_ORDER.map(function (d) {
				var sh = byDiff[d];
				if (!sh) return '<span class="chuni-badge chuni-badge-empty">—</span>';
				if (dKeySet) {
					var dk = DESIGNER_KEY[d];
					if (!dk || dKeySet.indexOf(dk) === -1) return '<span class="chuni-badge chuni-badge-empty">—</span>';
				}
				// 选了等级时，只显示对应等级的那张谱，其它难度留空
				if (state.levels.length && state.levels.indexOf(levelKey(sh.lv)) === -1) {
					return '<span class="chuni-badge chuni-badge-empty">—</span>';
				}
				var useCn = state.version === 'cn' && sh.cn != null;
				var val = useCn ? sh.cn : sh.iv;
				var html = badge(val, d);
				if (state.version === 'cn' && sh.cn == null) {
					html = html.replace('<span ', '<span title="暂无国服数据，显示的是 MATE 定数" ');
				}
				return html;
			}).join('');
			return '<a class="chuni-row" href="' + r.u + '">' +
				'<img class="chuni-thumb" src="' + r.cov + '" alt="" loading="lazy" />' +
				'<div class="chuni-row-main">' +
				'<div class="chuni-row-title">' + r.t + (r.cnrm ? '<span class="chuni-row-tag-removed">国服已删除</span>' : (r.rm ? '<span class="chuni-row-tag-removed">已删除</span>' : '')) + dsTag + '</div>' +
				'<div class="chuni-row-sub">' + r.a + ' · BPM ' + (r.b || '?') + ' · ' + r.v + '</div>' +
				'</div>' +
				'<div class="chuni-row-badges">' + badges + '</div>' +
				'</a>';
		}).join('');

		listEl.innerHTML = html;
		emptyEl.hidden = rows.length !== 0;
		countEl.textContent = '显示 ' + (rows.length ? start + 1 : 0) + '–' + (start + pageRows.length) + ' / ' + rows.length;
		totalEl.textContent = String(all.length);
		renderPager(pages);
	}

	function renderPager(pages) {
		if (pages <= 1) { pagerEl.innerHTML = ''; return; }
		var html = '';
		html += '<button type="button" class="chuni-pg" data-page="' + (state.page - 1) + '"' + (state.page <= 1 ? ' disabled' : '') + '>上一页</button>';
		var windowStart = Math.max(1, state.page - 2);
		var windowEnd = Math.min(pages, windowStart + 4);
		if (windowStart > 1) html += '<button type="button" class="chuni-pg" data-page="1">1</button>' + (windowStart > 2 ? '<span class="chuni-pg-gap">…</span>' : '');
		for (var p = windowStart; p <= windowEnd; p++) {
			html += '<button type="button" class="chuni-pg' + (p === state.page ? ' active' : '') + '" data-page="' + p + '">' + p + '</button>';
		}
		if (windowEnd < pages) html += (windowEnd < pages - 1 ? '<span class="chuni-pg-gap">…</span>' : '') + '<button type="button" class="chuni-pg" data-page="' + pages + '">' + pages + '</button>';
		html += '<button type="button" class="chuni-pg" data-page="' + (state.page + 1) + '"' + (state.page >= pages ? ' disabled' : '') + '>下一页</button>';
		html += '<span class="chuni-pg-info">第 ' + state.page + ' / ' + pages + ' 页</span>';
		pagerEl.innerHTML = html;
	}

	pagerEl.addEventListener('click', function (e) {
		var b = e.target.closest('.chuni-pg');
		if (!b || b.disabled) return;
		var p = Number(b.getAttribute('data-page'));
		if (!p || p === state.page) return;
		state.page = p;
		renderRows();
		window.scrollTo({ top: listEl.getBoundingClientRect().top + window.scrollY - 80, behavior: 'smooth' });
	});

	document.querySelectorAll('#chuni-version .chuni-seg-btn').forEach(function (b) {
		b.addEventListener('click', function () {
			document.querySelectorAll('#chuni-version .chuni-seg-btn').forEach(function (x) { x.classList.toggle('active', x === b); });
			state.version = b.getAttribute('data-version');
			state.page = 1;
			renderRows();
		});
	});

	document.querySelectorAll('#chuni-sort .chuni-sort-btn').forEach(function (b) {
		b.addEventListener('click', function () {
			var key = b.getAttribute('data-sort');
			if (key === 'dir') {
				state.dir = -state.dir;
				b.textContent = state.dir === 1 ? '正序 ↑' : '倒序 ↓';
				state.page = 1;
				renderRows();
				return;
			}
			// 三个排序互斥：点哪个就只留哪个
			if (key !== 'title' && key !== 'version' && key !== 'const') return;
			state.sort = key;
			document.querySelectorAll('#chuni-sort .chuni-sort-btn').forEach(function (x) {
				var k = x.getAttribute('data-sort');
				if (k === 'title' || k === 'version' || k === 'const') x.classList.toggle('active', k === key);
			});
			state.page = 1;
			renderRows();
		});
	});

	if (levelsEl) {
		levelsEl.addEventListener('click', function (e) {
			var b = e.target.closest('.chuni-lv-chip');
			if (!b) return;
			var lv = b.getAttribute('data-level');
			var i = state.levels.indexOf(lv);
			if (i === -1) state.levels.push(lv); else state.levels.splice(i, 1);
			b.classList.toggle('active');
			if (levelsEl) levelsEl.classList.toggle('filtering', state.levels.length > 0);
			state.page = 1;
			renderRows();
		});
	}

	function panelEl(id) { return document.getElementById(id); }

	function designerLabel(name, count) {
		return '<button type="button" class="chuni-dz-chip" data-who="' + String(name).replace(/"/g, '&quot;') + '">' +
			String(name) + '<span class="chuni-dz-n">' + count + '</span></button>';
	}

	// 选了难度时，谱师曲数只数这些难度上的谱
	function countFor(name, diffs) {
		var songs = DESIGNERS.songs || {};
		var n = 0;
		Object.keys(songs).forEach(function (k) {
			var rec = songs[k];
			var hit = diffs.some(function (d) {
				var x = rec[d];
				return x && (x.who === name || x.raw === name);
			});
			if (hit) n++;
		});
		return n;
	}

	function renderDesignerPanel() {
		var grid = panelEl('chuni-designer-grid');
		var looseEl = panelEl('chuni-designer-loose');
		if (!grid || !DESIGNERS) return;
		var q = (panelEl('chuni-designer-q').value || '').trim().toLowerCase();
		var picked = state.designerDiff && state.designerDiff.length ? state.designerDiff : null;
		var list = DESIGNERS.designers.map(function (d) {
			return { name: d.name, songs: picked ? countFor(d.name, picked) : d.songs, aliases: d.aliases, id: d.id };
		}).filter(function (d) {
			if (!q) return true;
			return d.name.toLowerCase().indexOf(q) !== -1;
		});
		if (picked) list.sort(function (a, b) { return b.songs - a.songs || a.name.localeCompare(b.name, 'ja'); });
		grid.innerHTML = list.map(function (d) { return designerLabel(d.name, d.songs); }).join('') ||
			'<div class="chuni-dz-none">没有匹配的谱师</div>';

		var loose = DESIGNERS.loose.map(function (d) {
			return { name: d.name, songs: picked ? countFor(d.name, picked) : d.songs };
		}).filter(function (d) {
			if (!q) return true;
			return d.name.toLowerCase().indexOf(q) !== -1;
		});
		if (picked) loose.sort(function (a, b) { return b.songs - a.songs || a.name.localeCompare(b.name, 'ja'); });
		if (looseEl) {
			looseEl.innerHTML = loose.slice(0, 120).map(function (d) { return designerLabel(d.name, d.songs); }).join('');
		}
		var summary = panelEl('chuni-designer-loose-summary');
		if (summary) summary.textContent = '其他名义（' + DESIGNERS.loose.length + ' 个，合作 / 恶搞名义）';
		markDesignerChips();
	}

	function markDesignerChips() {
		document.querySelectorAll('.chuni-dz-chip').forEach(function (b) {
			var who = b.getAttribute('data-who');
			var on = state.designer ? who === state.designer : (state.designerRaw && who === state.designerRaw);
			b.classList.toggle('active', !!on);
		});
	}

	// 谱师数从数据来，别写死（加了「制作者不明」这种伪谱师后会变）
	function syncDesignerCount() {
		var q = panelEl('chuni-designer-q');
		if (!q || !DESIGNERS || !DESIGNERS.designers) return;
		q.placeholder = '搜索谱师名（' + DESIGNERS.designers.length + ' 位）…';
	}

	function updateDesignerHint() {
		var hint = panelEl('chuni-designer-hint');
		var toggle = panelEl('chuni-designer-toggle');
		var label = state.designer || state.designerRaw || '';
		if (hint) hint.textContent = label ? '：' + label : '';
		if (toggle) toggle.classList.toggle('active', !!label);
	}

	// 从详情页返回时，把谱师/合作这些面板状态也一起恢复
	function syncDesignerUI() {
		updateDesignerHint();
		markDesignerChips();
		var cToggle = panelEl('chuni-collab-toggle');
		if (cToggle) cToggle.classList.toggle('active', !!state.collab);
		var dToggle = panelEl('chuni-designer-toggle');
		if (dToggle) {
			var active = !!(state.designer || state.designerRaw || state.collab);
			dToggle.classList.toggle('active', active);
		}
	}

	function pickDesigner(name) {
		var same = (state.designer === name) || (state.designerRaw === name);
		if (same) {
			state.designer = '';
			state.designerRaw = '';
		} else {
			var isReal = DESIGNERS && DESIGNERS.designers.some(function (d) { return d.name === name; });
			state.designer = isReal ? name : '';
			state.designerRaw = isReal ? '' : name;
		}
		state.page = 1;
		updateDesignerHint();
		markDesignerChips();
		renderRows();
	}

	function openDesignerPanel(open) {
		var panel = panelEl('chuni-designer-panel');
		var toggle = panelEl('chuni-designer-toggle');
		if (!panel || !toggle) return;
		panel.hidden = !open;
		toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
		toggle.classList.toggle('opened', open);
		if (open) {
			renderDesignerPanel();
			var q = panelEl('chuni-designer-q');
			if (q) q.focus({ preventScroll: true });
		}
	}

	var dToggle = panelEl('chuni-designer-toggle');
	if (dToggle) dToggle.addEventListener('click', function () {
		var panel = panelEl('chuni-designer-panel');
		openDesignerPanel(!!panel && panel.hidden);
	});
	var dClose = panelEl('chuni-designer-close');
	if (dClose) dClose.addEventListener('click', function () { openDesignerPanel(false); });
	var dClear = panelEl('chuni-designer-clear');
	if (dClear) dClear.addEventListener('click', function () {
		state.designer = '';
		state.designerRaw = '';
		state.page = 1;
		updateDesignerHint();
		markDesignerChips();
		renderRows();
	});

	var dPanel = panelEl('chuni-designer-panel');
	if (dPanel) dPanel.addEventListener('click', function (e) {
		var chip = e.target.closest('.chuni-dz-chip');
		if (chip) { pickDesigner(chip.getAttribute('data-who')); return; }
		var diff = e.target.closest('.chuni-diff-chip');
		if (diff && diff.hasAttribute('data-diff')) {
			var d = diff.getAttribute('data-diff');
			if (d === 'all') {
				state.designerDiff = [];
			} else {
				var arr = (state.designerDiff || []).slice();
				var i = arr.indexOf(d);
				if (i === -1) arr.push(d); else arr.splice(i, 1);
				state.designerDiff = arr;
			}
			dPanel.querySelectorAll('.chuni-diff-chip').forEach(function (x) {
				if (!x.hasAttribute('data-diff')) return;
				var v = x.getAttribute('data-diff');
				var on = v === 'all' ? (!state.designerDiff || !state.designerDiff.length) : state.designerDiff.indexOf(v) !== -1;
				x.classList.toggle('active', on);
			});
			state.page = 1;
			renderDesignerPanel();
			renderRows();
		}
	});

	var dq = panelEl('chuni-designer-q');
	if (dq) dq.addEventListener('input', renderDesignerPanel);

	var cToggle = panelEl('chuni-collab-toggle');
	if (cToggle) cToggle.addEventListener('click', function () {
		state.collab = !state.collab;
		cToggle.classList.toggle('active', state.collab);
		state.page = 1;
		renderRows();
	});

	var st = document.getElementById('chuni-search-title');
	if (st) st.addEventListener('input', function () { state.qt = st.value; state.page = 1; renderRows(); });
	var sa = document.getElementById('chuni-search-artist');
	if (sa) sa.addEventListener('input', function () { state.qa = sa.value; state.page = 1; renderRows(); });

	var weBtn = document.getElementById('chuni-we');
	if (weBtn) weBtn.addEventListener('click', function () {
		state.we = !state.we;
		weBtn.classList.toggle('active', state.we);
		state.page = 1;
		renderRows();
	});

	var cat = document.getElementById('chuni-cat');
	if (cat) cat.addEventListener('change', function () { state.cat = cat.value; state.page = 1; renderRows(); });

	var rmBtn = document.getElementById('chuni-removed');
	if (rmBtn) rmBtn.addEventListener('click', function () {
		state.removed = !state.removed;
		rmBtn.classList.toggle('active', state.removed);
		state.page = 1;
		renderRows();
	});

	fetch('/chuni-songs.json')
		.then(function (r) { return r.json(); })
		.then(function (rows) {
			all = rows;
			renderLevelChips();
			if (loadingEl) loadingEl.remove();
			var saved = loadListState();
			if (saved && saved.state) savedListState = saved;
			applySavedListState();
			renderRows();
			if (saved && saved.scroll) {
				setTimeout(function () { window.scrollTo(0, saved.scroll); }, 80);
			}
		})
		.catch(function () {
			if (loadingEl) loadingEl.textContent = '曲目数据加载失败';
		});

	fetch('/assets/data/designers.json')
		.then(function (r) { return r.json(); })
		.then(function (data) {
			DESIGNERS = data;
				renderDesignerPanel();
			syncDesignerCount();
		})
		.catch(function () {
			var toggle = panelEl('chuni-designer-toggle');
			if (toggle) toggle.title = '谱师数据没加载上';
		});

	fetch('/assets/data/collab.json')
		.then(function (r) { return r.json(); })
		.then(function (data) {
			COLLAB = data;
			// 合作数据可能比曲目数据晚到：把返回时要恢复的筛选补上，再重画一次
			applySavedListState();
			if (state.designer || state.designerRaw || state.collab) renderRows();
		})
		.catch(function () {
			var toggle = panelEl('chuni-collab-toggle');
			if (toggle) { toggle.title = '合作数据没加载上'; toggle.textContent = '合作数据加载失败'; }
		});
})();
</script>
